services:
  traefik:
    image: traefik:v3.0
    container_name: {{ edge_ingress_container_name }}
    network_mode: host
    volumes:
      - {{ edge_ingress_data_dir }}/traefik.yml:/traefik.yml:ro
      - {{ edge_ingress_data_dir }}/dynamic.yml:/dynamic.yml:ro
      - {{ edge_ingress_data_dir }}/acme.json:{{ edge_ingress_data_dir }}/acme.json:rw
    command:
      - "--api.insecure=false"
      - "--providers.file.filename=/traefik.yml"
      - "--providers.file.watch=true"
      - "--providers.docker=false"
      - "--entrypoints.web.address=:80"
      - "--entrypoints.websecure.address=:443"
      # The metrics entrypoint (:8082) and Prometheus config live in traefik.yml,
      # not here: that static config file is authoritative for entryPoints, so a
      # CLI-only metrics entrypoint is silently ignored (it never binds).
      - "--log.level=DEBUG"
      - "--log.format=json"
    environment:
      - GODADDY_API_KEY={{ godaddy_api_key }}
      - GODADDY_API_SECRET={{ godaddy_api_secret }}
      - GODADDY_PROPAGATION_TIMEOUT={{ edge_ingress_acme_propagation_timeout | default(300) }}
      - GODADDY_POLLING_INTERVAL={{ edge_ingress_acme_polling_interval | default(10) }}
      - GODADDY_TTL={{ edge_ingress_acme_dns_ttl | default(600) }}
    restart: always
    cap_add:
      - NET_BIND_SERVICE
    logging:
      driver: "json-file"
      options:
        max-size: "10m"
        max-file: "3"
        labels: "service=traefik"
