[Unit]
Description=Traefik Edge Ingress Service
Documentation=https://traefik.io/
After=docker.service tailscale.service network-online.target
Wants=network-online.target
Wants=docker.service
{% if internal_dns_enabled | default(false) %}
After=coredns.service
Wants=coredns.service
{% endif %}

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/bin/docker compose -f {{ edge_ingress_data_dir }}/docker-compose.yml up -d
ExecStop=/usr/bin/docker compose -f {{ edge_ingress_data_dir }}/docker-compose.yml down
ExecReload=/usr/bin/docker compose -f {{ edge_ingress_data_dir }}/docker-compose.yml restart
Restart=on-failure
RestartSec=10
StartLimitInterval=300
StartLimitBurst=5

# Wait for Docker to be ready
ExecStartPre=/bin/bash -c 'until docker info >/dev/null 2>&1; do sleep 1; done'

# Wait for Tailscale to be connected (if enabled)
{% if enable_tailscale | default(false) %}
ExecStartPre=/bin/bash -c 'until tailscale status >/dev/null 2>&1; do sleep 1; done'
{% endif %}

# Wait for network to be up
ExecStartPre=/bin/bash -c 'until ping -c 1 8.8.8.8 >/dev/null 2>&1; do sleep 1; done'

# Wait for CoreDNS if enabled
{% if internal_dns_enabled | default(false) %}
ExecStartPre=/bin/bash -c 'until systemctl is-active --quiet coredns.service; do sleep 1; done'
{% endif %}

# Health check - verify Traefik container is running
# Wait up to 30 seconds for container to start
ExecStartPost=/bin/bash -c 'for i in {1..30}; do if docker ps --filter name={{ edge_ingress_container_name }} --filter status=running --format "{{ "{{" }}.Names{{ "}}" }}" | grep -q "^{{ edge_ingress_container_name }}$"; then exit 0; fi; sleep 1; done; echo "Health check failed: Traefik container did not start within 30 seconds"; docker logs {{ edge_ingress_container_name }} --tail 20 2>&1 || true; exit 1'

[Install]
WantedBy=multi-user.target
