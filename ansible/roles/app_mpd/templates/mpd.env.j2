# mpd deployment config (gitignored). Managed by Ansible (app_mpd role).
# Passed to compose with --env-file (the compose file lives in docker/).
COMPOSE_PROJECT_NAME=mpd
HOST_UID={{ mpd_host_uid }}
HOST_GID={{ mpd_host_gid }}
MPD_PORT={{ mpd_port }}
MPD_ADMIN_TOKEN={{ mpd_admin_token }}
{% for key, value in (mpd_env | dictsort) %}
{{ key }}={{ value }}
{% endfor %}
