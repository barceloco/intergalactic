#!/usr/sbin/nft -f
# {{ ansible_managed | default('Managed by Ansible (firewall_nftables)') }}
#
# Allow-list firewall: every interface, Tailscale included, is deny-by-default.
# The same allow-list covers the host's own services (input) and
# Docker-published container ports (forward), because Docker DNATs published
# ports past the input chain.

# Manage ONLY our own 'inet filter' table. Do NOT `flush ruleset`: that also
# wipes Docker's dynamically-managed 'ip nat' / 'ip filter' chains (masquerade,
# DOCKER-USER, DOCKER-FORWARD, DOCKER-ISOLATION), which breaks all container
# networking until dockerd is restarted, and that in turn orphans the
# systemd-managed edge containers (traefik, coredns). Declaring then deleting
# the table makes the recreate below atomic and idempotent even on a fresh
# host, while leaving Docker's tables untouched so a firewall reload is safe
# to run while containers are up. A drop here is final even though Docker's
# own chains accept the same packet later.
table inet filter
delete table inet filter

{% macro source_match(src) -%}
{%- if src == 'tailnet' -%}
iifname "tailscale0"
{%- elif src == 'lan' -%}
iifname != "tailscale0" ip saddr {{ firewall_lan_subnet }}
{%- else -%}
iifname "tailscale0" ip saddr {{ fleet_tailscale_ipv4[src] }}
{%- endif -%}
{%- endmacro %}
table inet filter {
  # Every allowed (source, protocol, port), shared by input and forward. In the
  # forward path the port is the one the client connected to
  # (ct original proto-dst), not the container port Docker rewrote it to.
  chain allowed {
    # SSH: always reachable over the tailnet and from the local LAN.
{% if enable_tailscale | default(false) %}
    iifname "tailscale0" tcp dport {{ ssh_port | default(22) }} accept
{% endif %}
    iifname != "tailscale0" ip saddr {{ firewall_lan_subnet }} tcp dport {{ ssh_port | default(22) }} accept

{% if enable_tailscale | default(false) %}
{% if internal_dns_enabled | default(false) %}
    # Internal DNS (CoreDNS) for tailnet clients.
    iifname "tailscale0" udp dport 53 accept
    iifname "tailscale0" tcp dport 53 accept
{% endif %}
{% if edge_ingress_enabled | default(false) %}
    # Edge ingress (Traefik) for tailnet clients.
    iifname "tailscale0" tcp dport { 80, 443 } accept
{% endif %}
{% endif %}
{% for rule in firewall_rules %}
{% set ports = rule.port if rule.port is iterable and rule.port is not string else [rule.port] %}
{% set proto = rule.proto | default('tcp') %}
    # {{ rule.comment }}
{% for src in rule.from %}
    {{ source_match(src) }} {{ proto }} dport { {{ ports | join(', ') }} } accept
{% endfor %}
{% endfor %}
  }

  # Same allow-list for forwarded (DNAT'd) traffic, keyed on the original port.
  chain allowed_published {
{% if enable_tailscale | default(false) %}
    iifname "tailscale0" meta l4proto tcp ct original proto-dst {{ ssh_port | default(22) }} accept
{% endif %}
    iifname != "tailscale0" ip saddr {{ firewall_lan_subnet }} meta l4proto tcp ct original proto-dst {{ ssh_port | default(22) }} accept
{% if enable_tailscale | default(false) %}
{% if internal_dns_enabled | default(false) %}
    iifname "tailscale0" meta l4proto { tcp, udp } ct original proto-dst 53 accept
{% endif %}
{% if edge_ingress_enabled | default(false) %}
    iifname "tailscale0" meta l4proto tcp ct original proto-dst { 80, 443 } accept
{% endif %}
{% endif %}
{% for rule in firewall_rules %}
{% set ports = rule.port if rule.port is iterable and rule.port is not string else [rule.port] %}
{% set proto = rule.proto | default('tcp') %}
    # {{ rule.comment }}
{% for src in rule.from %}
    {{ source_match(src) }} meta l4proto {{ proto }} ct original proto-dst { {{ ports | join(', ') }} } accept
{% endfor %}
{% endfor %}
  }

  chain input {
    type filter hook input priority 0;
    policy drop;

    iif lo accept
    ct state established,related accept
    ct state invalid drop

    # Ping from the tailnet and the local LAN.
{% if enable_tailscale | default(false) %}
    iifname "tailscale0" icmp type echo-request accept
    iifname "tailscale0" icmpv6 type echo-request accept
{% endif %}
    iifname != "tailscale0" ip saddr {{ firewall_lan_subnet }} icmp type echo-request accept
    # IPv6 neighbour discovery: link-local only (hop limit 255), needed for IPv6
    # to work at all on the LAN.
    icmpv6 type { nd-neighbor-solicit, nd-neighbor-advert, nd-router-solicit, nd-router-advert } ip6 hoplimit 255 accept

{% if enable_tailscale | default(false) %}
    # Tailscale's own transport (not a service): direct peer connections.
    udp dport 41641 accept
{% endif %}

    jump allowed

    limit rate {{ firewall_rate_limit }}/second counter log prefix "nft-in-drop: "
    counter drop
  }

{% set forward_mode = firewall_forward_mode if firewall_forward_mode | length > 0 else ('docker' if enable_docker | default(false) else 'drop') %}
  chain forward {
    type filter hook forward priority 0;
{% if forward_mode == 'bridge' %}
    # Hypervisor: VMs are bridged onto the LAN and are hosts in their own
    # right, each with its own firewall. The host does not filter their
    # traffic; the input chain above still protects the hypervisor itself.
    policy accept;
{% elif forward_mode == 'docker' %}
    # Docker routes container traffic through here and manages its own chains
    # in 'ip filter'; only NEW connections to published ports are filtered.
    policy accept;

    ct state established,related accept
    # Containers reaching published ports (hairpin) stay allowed.
    iifname "docker0" accept
    iifname "br-*" accept
    ct state new ct status dnat jump published
{% else %}
    policy drop;
{% endif %}
  }
{% if forward_mode == 'docker' %}

  chain published {
    jump allowed_published
    limit rate {{ firewall_rate_limit }}/second counter log prefix "nft-fwd-drop: "
    counter drop
  }
{% endif %}

  chain output {
    type filter hook output priority 0;
    policy accept;
  }
}
