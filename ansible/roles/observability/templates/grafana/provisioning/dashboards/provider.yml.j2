# Rendered by the observability role. Loads dashboards from disk as code, so the
# dashboards are versioned in the repo rather than edited in the UI.
apiVersion: 1
providers:
  - name: fleet
    orgId: 1
    folder: Fleet
    type: file
    disableDeletion: true
    allowUiUpdates: false
    options:
      path: /var/lib/grafana/dashboards
      foldersFromFilesStructure: false
