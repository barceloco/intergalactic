# Rendered by the observability role. Edit the role, not this file on the host.
global:
  scrape_interval: 30s
  evaluation_interval: 30s

scrape_configs:
  # Prometheus scraping itself.
  - job_name: prometheus
    static_configs:
      - targets: ["localhost:9090"]

  # End-to-end synthetic probes of every edge route: https://<host><health_path>.
  # A success here proves CoreDNS resolved the name, Traefik terminated TLS and
  # routed it, and the app answered. Targets are derived from edge_ingress_routes
  # so probing shares the single source of truth with DNS and the Traefik routers.
  - job_name: blackbox-http
    metrics_path: /probe
    params:
      module: [http_2xx]
    static_configs:
      - targets:
{% for r in observability_probe_routes %}
          - "https://{{ r.host }}{{ r.health_path | default('/') }}"
{% endfor %}
    relabel_configs:
      - source_labels: [__address__]
        target_label: __param_target
      - source_labels: [__param_target]
        target_label: instance
      - target_label: __address__
        replacement: "blackbox:{{ observability_blackbox_port }}"

  # node_exporter on each fleet host: host metrics plus app_build_info provenance
  # (repo/branch/commit ansible deployed), exposed via the textfile collector.
  - job_name: node
    static_configs:
      - targets:
{% for t in observability_node_targets %}
          - "{{ t }}"
{% endfor %}

{% if (observability_traefik_metrics_target | default('')) | length > 0 %}
  # Traefik's own metrics: per-router/service health, request rates, status codes.
  - job_name: traefik
    static_configs:
      - targets: ["{{ observability_traefik_metrics_target }}"]
{% endif %}
