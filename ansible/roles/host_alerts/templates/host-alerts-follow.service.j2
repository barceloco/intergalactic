# {{ ansible_managed | default('Managed by Ansible (host_alerts)') }}
[Unit]
Description=Push SSH logins, sudo use and local sessions (host_alerts)
After=systemd-journald.service network-online.target
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
ExecStart=/usr/local/sbin/host-alerts-follow
Restart=always
RestartSec=5
Nice=5

[Install]
WantedBy=multi-user.target
