# docgen deployment config. See README "Tailscale and access control".
#
# DOCGEN_ADMINS is authoritative here. docker-compose.yml passes it through as
# ${DOCGEN_ADMINS:-<default>}; if this line is ever removed, an empty value must
# NOT reach the container (that silently wipes admin access). Keep it set.
DOCGEN_ADMINS={{ docgen_env.DOCGEN_ADMINS }}
