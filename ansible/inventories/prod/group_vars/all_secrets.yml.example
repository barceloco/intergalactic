---
# Secrets file template
# Copy this file to all_secrets.yml (which is gitignored) and fill in your actual values
#
# Usage:
#   cp all_secrets.yml.example all_secrets.yml
#   # Edit all_secrets.yml with your actual keys and secrets

# SSH public keys for the automation user (ansible)
automation_authorized_keys:
  - "ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAI... ansible@control"
  # Add additional keys as needed

# Human user accounts with their SSH public keys
human_users:
  - name: armand
    authorized_keys:
      - "ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAI... user@laptop"
      # Add additional keys as needed

# Tailscale authentication key (one-time use key from Tailscale admin console)
tailscale_authkey: "tskey-auth-..."

# Samba passwords for armand user (per-host, for SMB/CIFS file sharing)
# Only needed if enable_samba is true for a host
# Samba uses its own password database (separate from system password)
# Set this to match the system password for user 'armand' if you want to use the same password
# Future system password changes will sync to Samba automatically (unix password sync = yes)
# Add entries for each host that has enable_samba: true
samba_armand_passwords:
  vega: "CHANGE_me."
  rigel: "CHANGE_me."
  phecda: "CHANGE_me."   # the arcturus file server (VM phecda)
  # Add more hosts as needed:
  # hostname: "password-here"
# GoDaddy DNS API credentials for ACME DNS-01 challenge (Traefik edge ingress)
# Get your API key and secret from: https://developer.godaddy.com/keys
# Only needed if cert_issuer_enabled is true for a host
# Create an account at https://developer.godaddy.com, then create API keys
godaddy_api_key: "GoDaddy_API_Key_here"
godaddy_api_secret: "GoDaddy_API_Secret_here"

# Proxmox web UI administrator (proxmox_admin_user, default armand@pve) on
# hosts with proxmox_enabled. At least 12 characters.
proxmox_admin_password: "CHANGE_ME"

# immich database password (app_immich, VM alkaid). Letters and digits only,
# 16 or more characters; generate it in your password manager.
immich_db_password: "CHANGE_ME"

# Push notifications (role notify, ntfy). On a public server such as ntfy.sh
# the topic name works like a password: 16+ random letters, digits, - or _.
# The token is optional (access token for a protected topic).
notify_ntfy_topic: "CHANGE_ME_random_topic_name"
notify_ntfy_token: ""

# docgen administrators (app_docgen; vega today, dubhe on arcturus): rendered
# into docgen's .env as DOCGEN_ADMINS, the allow-list of Tailscale identities
# that get admin access (format: see docgen's documentation). Never leave it
# empty: an empty value wipes every admin (docgen answers 403).
docgen_admins: "CHANGE_ME"
